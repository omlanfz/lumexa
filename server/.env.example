# FILE PATH: server/.env.example
#
# No .env.example previously existed in this repo — this documents every
# environment variable the backend currently reads (grepped from
# server/src/**/*.ts), grouped by concern. Copy to `.env` for local
# development; on Render, set these under Environment.

# ─── Database (Neon/Postgres) ────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&channel_binding=require&pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://user:password@host/db?sslmode=require&channel_binding=require"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="replace-with-a-long-random-secret"
PORT=3000
NODE_ENV="development"

# ─── Frontend / CORS ────────────────────────────────────────────────────────────
# Canonical production frontend URL — used to build every link in outbound
# emails (classroom links, dashboard links, password reset links, etc.) and
# to allow that origin through CORS. Set this to the real deployed frontend
# URL (e.g. your Vercel production domain) — never hard-code a domain in code.
#
# Certificates depend on it too: the QR code on every certificate, its public
# verification link (FRONTEND_URL/verify/<certificate id>), the congratulatory
# email's links and the share links are ALL built from this one value, so moving
# to a new domain means changing it here and nothing else. There is NO fallback:
# if it is missing or not a valid https:// address, certificates are not issued
# (the admin's Certificates page says why). A comma-separated list is allowed (the
# FIRST entry is the public site). Certificates already issued keep the QR code
# they were printed with, so keep the old domain redirecting to the new one.
FRONTEND_URL="http://localhost:3000"
# Optional comma-separated list of additional exact CORS origins.
ALLOWED_ORIGINS=""

# ─── Email (Gmail SMTP + Nodemailer — the ONLY email transport this app uses) ──
# Requires a Gmail account with 2FA enabled and an "App Password" generated
# for this app (Google Account → Security → App passwords). Do NOT use the
# account's normal login password. Never commit real credentials.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="lumexa.school@gmail.com"
SMTP_PASS="your-16-character-gmail-app-password"
# From-address domain fallback if SMTP_USER is somehow unset (should not
# normally happen — SMTP_USER is used as the actual From address).
EMAIL_DOMAIN="lumexa.app"
# Display name recipients see: "Lumexa AI School <SMTP_USER>". The address is
# always SMTP_USER (Gmail rewrites any other From), so SMTP_USER must be the
# official lumexa.school@gmail.com account.
EMAIL_FROM_NAME="Lumexa AI School"

# Comma-separated list of email addresses that receive admin/Operations
# alerts (new registrations, disputes, high cancellation rate, low
# activity, system errors, and now "new trial booked"). Required for any
# admin email to actually send. Set the real address in Render's Environment
# tab (it is the admin's private address — don't commit it).
ADMIN_NOTIFICATION_EMAILS="admin@example.com"

# ─── Admin alert thresholds (configurable, not hard-coded) ─────────────────────
# Emergency reschedules/cancellations in a calendar month before a teacher
# triggers a "high cancellation rate" admin alert.
TEACHER_CANCELLATION_ALERT_THRESHOLD="5"
# Days without a login before a teacher triggers a "low activity" admin alert.
TEACHER_INACTIVITY_DAYS="14"

# ─── Payments (Stripe) ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── File storage (Cloudinary — verification docs) ─────────────────────────────
# (Certificates no longer use Cloudinary — see "Certificates" below. Certificates
# issued by the previous system are still served from here.)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Classroom (Daily) ───────────────────────────────────────────────────────────
# Live classes run on Daily (https://www.daily.co). The server creates each class's
# private Daily room and signs every person's way into it with this one key. Get it
# in the Daily dashboard → Developers → API keys. Nothing else is needed: a room's
# address comes back from Daily itself. Full setup: docs/CLASSROOM_DAILY_SETUP.md
DAILY_API_KEY=""
# Optional — only for tests or a Daily regional endpoint. Default: https://api.daily.co/v1
# DAILY_API_URL=""

# ─── Classroom recording storage (Cloudflare R2) ─────────────────────────────────
# A class is recorded in the TEACHER'S BROWSER (a WebM file of their browser
# window plus the class's audio) and uploaded by that browser straight to a
# PRIVATE R2 bucket, using a short-lived URL this server signs. Students watch
# through signed URLs too. Daily's cloud recording and FFmpeg are NOT used, and nothing
# below is needed to press Record — only to upload and to watch.
#
# Full setup (bucket, API token, CORS, testing): docs/CLASS_RECORDING_SETUP.md
#
# If any of the four is missing, uploading returns 400 "Recording storage is not
# set up on the server yet: missing <exact names>", and the Render log says so at
# start-up. (The old S3_* settings of the previous server-side recorder are no
# longer read anywhere — remove them from Render.)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Optional: the full S3 endpoint, instead of the one built from R2_ACCOUNT_ID
# (https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com). Only for an EU-jurisdiction
# bucket (https://<R2_ACCOUNT_ID>.eu.r2.cloudflarestorage.com) or a local
# S3-compatible server in development.
R2_ENDPOINT=""
# Longest one recording (one Record → Stop) may run, in minutes. The teacher's
# browser stops it by itself at this length; record again for a next part.
RECORDING_MAX_DURATION_MINUTES="70"
# Total bytes of uploaded recordings kept before the retention policy removes the
# oldest ones. Admins are warned at 80% of this. Default below is 50 GB.
RECORDING_STORAGE_LIMIT_BYTES="53687091200"

# ─── Homework file storage (Cloudflare R2) — a SEPARATE bucket ───────────────────
# Students' homework files (.py, .ipynb, .html, .css, .js, .java, .sb3, .rbxl, PDFs,
# images, …) are stored in their OWN private R2 bucket, with their OWN API token —
# never in the class-recordings bucket above, whose settings are not read here. The
# files are kept until the teacher has saved the review, then removed. Students
# upload through this server; a teacher gets a short-lived signed link to open one.
#
# Full setup (bucket, token, testing): docs/HOMEWORK_SUBMISSIONS_SETUP.md
#
# If any is missing (or HOMEWORK_R2_BUCKET is the recordings bucket) file uploads
# answer 503 "Uploading files is not available right now" — links still work — and
# the log says which setting is wrong at start-up.
HOMEWORK_R2_BUCKET=""
HOMEWORK_R2_ACCESS_KEY_ID=""
HOMEWORK_R2_SECRET_ACCESS_KEY=""
# Cloudflare account id. Optional when it is the same account as R2_ACCOUNT_ID
# (an id, not a secret) — then that one is used.
HOMEWORK_R2_ACCOUNT_ID=""
# Optional: the full S3 endpoint (EU jurisdiction, or a local S3-compatible server).
HOMEWORK_R2_ENDPOINT=""

# ─── Classroom chat history (Cloudflare R2) — a SEPARATE bucket ──────────────────
# The classroom chat is saved so it is still there in the next class: for a 1:1, as
# long as it is the same teacher and student; for a batch, as long as it is the same
# batch and teacher (a student who joins late starts empty; one who leaves sees
# nothing). Messages are small JSON files in their OWN private R2 bucket with their
# OWN API token — never the recordings or homework bucket (refused at start-up).
# Browsers never see these credentials: they talk to this server.
#
# Full setup (bucket, token, testing): docs/CLASSROOM_CHAT_SETUP.md
#
# If any is missing (or CHAT_R2_BUCKET is the recordings/homework bucket) chat still
# works live exactly as before, but nothing is saved or shown again later — and the
# log says which setting is wrong at start-up.
CHAT_R2_BUCKET=""
CHAT_R2_ACCESS_KEY_ID=""
CHAT_R2_SECRET_ACCESS_KEY=""
# Cloudflare account id. Optional when it is the same account as R2_ACCOUNT_ID
# (an id, not a secret) — then that one is used.
CHAT_R2_ACCOUNT_ID=""
# Optional: the full S3 endpoint (EU jurisdiction, or a local S3-compatible server).
CHAT_R2_ENDPOINT=""

# ─── Certificates of Completion (Cloudflare R2 + headless Chromium) ──────────────
# A certificate is approved by an admin, then rendered ONCE to a landscape A4 PDF
# and a high-resolution PNG, which are stored in their OWN private R2 bucket
# (`lumexa-certificates`) with their OWN API token — never the recordings, homework
# or chat bucket (refused at start-up). Certificate files are kept FOREVER: the
# server has no code path that deletes or overwrites one, and the bucket should also
# carry an indefinite Bucket Lock rule (R2 then refuses deletion whatever the code
# or the credentials say) — R2 has no "write but never delete" token level, so the
# lock rule, not the token, is what guarantees it. Scope the token to this bucket.
#
# Full setup (bucket, lock rule, token, Chromium, testing): docs/CERTIFICATES_SETUP.md
#
# If any of the three below is missing, issuing a certificate answers 503 "Certificates
# cannot be issued yet" (and the admin's Certificates page says exactly what is
# missing); nothing else in the app is affected.
CERTIFICATE_R2_BUCKET="lumexa-certificates"
CERTIFICATE_R2_ACCESS_KEY_ID=""
CERTIFICATE_R2_SECRET_ACCESS_KEY=""
# Cloudflare account id. Optional when it is the same account as R2_ACCOUNT_ID
# (an id, not a secret) — then that one is used.
CERTIFICATE_R2_ACCOUNT_ID=""
# Optional: the full S3 endpoint (EU jurisdiction, or a local S3-compatible server).
CERTIFICATE_R2_ENDPOINT=""
# Rendering needs Chromium. `npm install` downloads one for Puppeteer (kept inside
# server/.cache, see .puppeteerrc.cjs). To use a Chromium you installed yourself (a
# Docker image, a system package), install with PUPPETEER_SKIP_DOWNLOAD=true and
# point at it here (PUPPETEER_EXECUTABLE_PATH is also honoured).
CERTIFICATE_CHROMIUM_PATH=""

# ─── Little Coders lesson videos (Cloudflare R2) — a SEPARATE bucket ──────────────
# The 40 "Your Learning Preview" videos of the Little Coders lessons are kept in their
# OWN private R2 bucket (`lumexa-lesson-videos`) with their OWN API token — never the
# recordings, homework, chat or certificate bucket (refused at start-up). Nothing in
# this bucket is ever deleted by the server: there is no delete code path, so a lesson
# video is kept indefinitely. Students watch through a signed link (valid for 6 hours)
# the server makes every time a lesson opens — or, if you put a public domain in front
# of the bucket, set LESSON_VIDEO_PUBLIC_BASE_URL and plain public addresses are used.
#
# Full setup (bucket, token, uploading the videos, testing): docs/LESSON_VIDEOS_SETUP.md
#
# If any of the four below is missing, lessons keep showing "Video coming soon" and the
# admin lesson editor says exactly what is missing; nothing else in the app is affected.
LESSON_VIDEO_R2_BUCKET="lumexa-lesson-videos"
LESSON_VIDEO_R2_ACCESS_KEY_ID=""
LESSON_VIDEO_R2_SECRET_ACCESS_KEY=""
# Cloudflare account id. Optional when it is the same account as R2_ACCOUNT_ID
# (an id, not a secret) — then that one is used.
LESSON_VIDEO_R2_ACCOUNT_ID=""
# Optional: the full S3 endpoint (EU jurisdiction, or a local S3-compatible server).
LESSON_VIDEO_R2_ENDPOINT=""
# Optional: the public https address of the bucket (a custom domain or the r2.dev address).
# Leave empty to keep the bucket private and use signed links.
LESSON_VIDEO_PUBLIC_BASE_URL=""

# ─── Lumi AI assistant ────────────────────────────────────────────────────────
OLLAMA_URL=""
OLLAMA_MODEL=""

# ─── Assessment AI grading ──────────────────────────────────────────────────────
AI_GRADING_PROVIDER=""
AI_GRADING_API_KEY=""
AI_GRADING_BASE_URL=""
AI_GRADING_MODEL=""

# ─── Trial class booking ────────────────────────────────────────────────────────
# Availability itself (weekly windows, holidays) is managed in the admin
# dashboard → Trial Classes, in Bangladesh time (Asia/Dhaka).
# A slot must start at least this many minutes from now to be bookable.
TRIAL_MIN_NOTICE_MINUTES="120"
# How many days ahead parents can book.
TRIAL_BOOKING_HORIZON_DAYS="60"

# The parent's secure classroom link is FRONTEND_URL + /trial/join/<token>, so
# FRONTEND_URL (above) must be the public https:// address of the website.
# Guests join through the same Daily account as every class (DAILY_API_KEY above);
# no extra provider or credentials are needed.

# ─── WhatsApp Cloud API (Meta) — trial notifications ONLY ──────────────────────
# Direct Meta integration (no Twilio). Leave WHATSAPP_ENABLED=false until the
# Meta setup in docs/TRIAL_NOTIFICATIONS_SETUP.md is finished: bookings and
# emails work fine without it, WhatsApp messages are simply skipped.
WHATSAPP_ENABLED="false"
# Check https://developers.facebook.com/docs/graph-api/changelog for the
# versions currently supported and bump this before the old one expires.
WHATSAPP_GRAPH_API_VERSION="v25.0"
# "Phone number ID" of the registered Lumexa sender (+8801522122194) — from
# WhatsApp Manager → API setup. It is an ID, not the phone number itself.
WHATSAPP_PHONE_NUMBER_ID=""
# Permanent System User access token with whatsapp_business_messaging
# (+ whatsapp_business_management). SECRET — set only in Render/.env.
WHATSAPP_ACCESS_TOKEN=""
# Admin's personal WhatsApp number in international format (e.g. +8801XXXXXXXXX).
# Receives the "new trial booked" alert, and is also the WhatsApp inbox parents
# are sent to when they ask to buy class credits (the "Make a payment" button in
# the low-credit emails and the student Payments & Credits page open a chat with
# it, so it is visible to them). When empty, the default admin number in
# src/whatsapp/whatsapp.config.ts (DEFAULT_ADMIN_WHATSAPP_NUMBER) is used for
# those payment chats.
WHATSAPP_ADMIN_RECIPIENT=""
# Template names + language exactly as approved in WhatsApp Manager.
WHATSAPP_TEMPLATE_LANGUAGE="en"
WHATSAPP_TEMPLATE_PARENT_CONFIRMATION="lumexa_trial_confirmation"
# Sent when a teacher is assigned (and again if the time changes): details + class link.
WHATSAPP_TEMPLATE_PARENT_CLASS_DETAILS="lumexa_trial_class_details"
# Sent 1 hour before the class, with the same link.
WHATSAPP_TEMPLATE_PARENT_REMINDER="lumexa_trial_class_reminder"
WHATSAPP_TEMPLATE_ADMIN_ALERT="lumexa_trial_admin_alert"
# "positional" = {{1}}, {{2}} … (default). Use "named" only if you created the
# templates with named variables ({{parent_name}} …).
WHATSAPP_TEMPLATE_PARAMETER_FORMAT="positional"

# ─── Student progress ──────────────────────────────────────────────────────────
# A few seconds after start-up every student's rank / streak / badges are
# reconciled with their class records (idempotent and silent — see
# docs/STUDENT_PROGRESS_AND_CREDITS.md). Set to "true" to skip that pass.
SKIP_STUDENT_PROGRESS_BACKFILL=""

# ─── Code Lab: running C, C++ and Java in lessons (optional) ───────────────────
# JavaScript, Python, SQL and HTML run inside the learner's own browser and need nothing here. C, C++ and
# Java need a compiler, so they run on a separate, isolated code-runner service (a self-hosted Piston,
# https://github.com/engineer-man/piston: containers, no network, time and memory limits). The Lumexa server
# never compiles or runs learner code itself; it only forwards the program to this service.
# Leave CODE_RUNNER_URL empty and the Code Lab simply shows no Run button for those three languages (and says
# why): nothing is faked. See docs/PRE_UNIVERSITY_CSE.md for the setup.
CODE_RUNNER_URL=""
# Optional: the Authorization value the service expects (leave empty if it needs none).
CODE_RUNNER_TOKEN=""
