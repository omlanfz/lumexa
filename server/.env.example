# FILE PATH: server/.env.example
#
# No .env.example previously existed in this repo — this documents every
# environment variable the backend currently reads (grepped from
# server/src/**/*.ts), grouped by concern. Copy to `.env` for local
# development; on Render, set these under Environment.

# ─── Database (Neon/Postgres) ────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&channel_binding=require&pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://user:password@host/db?sslmode=require&channel_binding=require"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="replace-with-a-long-random-secret"
PORT=3000
NODE_ENV="development"

# ─── Frontend / CORS ────────────────────────────────────────────────────────────
# Canonical production frontend URL — used to build every link in outbound
# emails (classroom links, dashboard links, password reset links, etc.) and
# to allow that origin through CORS. Set this to the real deployed frontend
# URL (e.g. your Vercel production domain) — never hard-code a domain in code.
FRONTEND_URL="http://localhost:3000"
# Optional comma-separated list of additional exact CORS origins.
ALLOWED_ORIGINS=""

# ─── Email (Gmail SMTP + Nodemailer — the ONLY email transport this app uses) ──
# Requires a Gmail account with 2FA enabled and an "App Password" generated
# for this app (Google Account → Security → App passwords). Do NOT use the
# account's normal login password. Never commit real credentials.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="lumexa.school@gmail.com"
SMTP_PASS="your-16-character-gmail-app-password"
# From-address domain fallback if SMTP_USER is somehow unset (should not
# normally happen — SMTP_USER is used as the actual From address).
EMAIL_DOMAIN="lumexa.app"
# Display name recipients see: "Lumexa AI School <SMTP_USER>". The address is
# always SMTP_USER (Gmail rewrites any other From), so SMTP_USER must be the
# official lumexa.school@gmail.com account.
EMAIL_FROM_NAME="Lumexa AI School"

# Comma-separated list of email addresses that receive admin/Operations
# alerts (new registrations, disputes, high cancellation rate, low
# activity, system errors, and now "new trial booked"). Required for any
# admin email to actually send. Set the real address in Render's Environment
# tab (it is the admin's private address — don't commit it).
ADMIN_NOTIFICATION_EMAILS="admin@example.com"

# ─── Admin alert thresholds (configurable, not hard-coded) ─────────────────────
# Emergency reschedules/cancellations in a calendar month before a teacher
# triggers a "high cancellation rate" admin alert.
TEACHER_CANCELLATION_ALERT_THRESHOLD="5"
# Days without a login before a teacher triggers a "low activity" admin alert.
TEACHER_INACTIVITY_DAYS="14"

# ─── Payments (Stripe) ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── File storage (Cloudinary — verification docs, certificates) ───────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Classroom (LiveKit) ─────────────────────────────────────────────────────────
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# ─── Classroom recording storage (S3-compatible) ────────────────────────────────
# ALL SIX of the vars above and below (or their AWS_* fallbacks) must be set
# for the Record button to work at all — see RecordingService.
# missingEgressEnvVars()/egressConfigured() in
# server/src/classroom/recording.service.ts. If any are missing, clicking
# Record returns 400 "Recording is not configured for this environment:
# missing <exact var names>." naming exactly what to set here. For
# self-hosted MinIO, set S3_ENDPOINT (this also switches the Egress upload
# and the merge job's S3 client to path-style addressing, which MinIO
# requires); leave it unset for plain AWS S3.
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
# Hard cap on a single recording segment (one Record start→stop), minutes.
# Enforced server-side by a cron sweep, not just the UI — see
# RecordingService.enforceMaxSegmentDuration.
RECORDING_MAX_DURATION_MINUTES="70"
# Total bytes of AVAILABLE recordings before the retention policy starts
# deleting the oldest completed ones (never active/processing). Admins are
# warned at 80% of this. Default below is 50 GB.
RECORDING_STORAGE_LIMIT_BYTES="53687091200"

# ─── Lumi AI assistant ────────────────────────────────────────────────────────
OLLAMA_URL=""
OLLAMA_MODEL=""

# ─── Assessment AI grading ──────────────────────────────────────────────────────
AI_GRADING_PROVIDER=""
AI_GRADING_API_KEY=""
AI_GRADING_BASE_URL=""
AI_GRADING_MODEL=""

# ─── Trial class booking ────────────────────────────────────────────────────────
# Availability itself (weekly windows, holidays) is managed in the admin
# dashboard → Trial Classes, in Bangladesh time (Asia/Dhaka).
# A slot must start at least this many minutes from now to be bookable.
TRIAL_MIN_NOTICE_MINUTES="120"
# How many days ahead parents can book.
TRIAL_BOOKING_HORIZON_DAYS="60"

# ─── WhatsApp Cloud API (Meta) — trial notifications ONLY ──────────────────────
# Direct Meta integration (no Twilio). Leave WHATSAPP_ENABLED=false until the
# Meta setup in docs/TRIAL_NOTIFICATIONS_SETUP.md is finished: bookings and
# emails work fine without it, WhatsApp messages are simply skipped.
WHATSAPP_ENABLED="false"
# Check https://developers.facebook.com/docs/graph-api/changelog for the
# versions currently supported and bump this before the old one expires.
WHATSAPP_GRAPH_API_VERSION="v25.0"
# "Phone number ID" of the registered Lumexa sender (+8801522122194) — from
# WhatsApp Manager → API setup. It is an ID, not the phone number itself.
WHATSAPP_PHONE_NUMBER_ID=""
# Permanent System User access token with whatsapp_business_messaging
# (+ whatsapp_business_management). SECRET — set only in Render/.env.
WHATSAPP_ACCESS_TOKEN=""
# Admin's personal WhatsApp number in international format (e.g. +8801XXXXXXXXX).
# Receives the "new trial booked" alert. Private — never shown in the UI.
WHATSAPP_ADMIN_RECIPIENT=""
# Template names + language exactly as approved in WhatsApp Manager.
WHATSAPP_TEMPLATE_LANGUAGE="en"
WHATSAPP_TEMPLATE_PARENT_CONFIRMATION="lumexa_trial_confirmation"
WHATSAPP_TEMPLATE_PARENT_REMINDER="lumexa_trial_reminder"
WHATSAPP_TEMPLATE_ADMIN_ALERT="lumexa_trial_admin_alert"
# "positional" = {{1}}, {{2}} … (default). Use "named" only if you created the
# templates with named variables ({{parent_name}} …).
WHATSAPP_TEMPLATE_PARAMETER_FORMAT="positional"
