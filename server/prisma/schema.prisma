generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  password       String
  fullName       String
  createdAt      DateTime  @default(now())
  role           Role      @default(PARENT)
  coppaConsentAt DateTime?
  avatarUrl      String?

  // Set on every successful password login (AuthService.login /
  // StudentsService.loginStudent) — used only to detect platform
  // inactivity (see AdminAlertsService low-activity check). Never set on
  // registration, impersonation, or any other flow.
  lastLoginAt DateTime?

  // Admin-recorded WhatsApp contact number (any role) — Lumexa Operations
  // corresponds with students/teachers over WhatsApp, so this is entered/
  // edited by Operations from the admin dashboard, not self-served today.
  whatsappNumber String?

  // Plaintext copy of the password Operations most recently SET for this
  // account via the admin dashboard (see AdminService.resetUserPassword) —
  // shown back to Operations so they can hand it to the teacher/student.
  // `password` above is the bcrypt hash used for auth and is never
  // reversible; this field only ever reflects a password Operations chose
  // and is cleared the moment the account holder changes it themselves
  // (see AuthService.changePassword), since Operations no longer knows it
  // at that point. Never exposed outside admin-guarded endpoints.
  adminSetPassword String?

  // STUDENT identity fields (null on TEACHER/ADMIN/PARENT rows)
  age           Int?
  grade         String?
  subjects      String[]      @default([])
  spaceRank     SpaceRank     @default(STARCHILD)
  totalSessions Int           @default(0)
  streakWeeks   Int           @default(0)
  gemBalance    Int           @default(0)
  accountStatus AccountStatus @default(ACTIVE)

  // Operations-controlled default teacher assignment (informational — not the
  // source of truth for any individual booking's teacher).
  assignedTeacherId String?
  assignedTeacher   TeacherProfile? @relation("AssignedTeacher", fields: [assignedTeacherId], references: [id])

  // Operations-controlled course assignment (informational, same pattern as
  // assignedTeacherId — not the source of truth for any individual booking).
  assignedCourseId String?
  assignedCourse   Course? @relation(fields: [assignedCourseId], references: [id])

  // Class type for the student's current assignment (1-to-1 = 45min lessons,
  // BATCH = 60min lessons) — set together with the weekly recurring schedule.
  // See RecurringSlot / ScheduledLesson below.
  assignedClassType ClassType?

  // Billing contact — server-side only, never returned in student API responses
  billingContactEmail     String?
  billingContactStripeId  String?
  billingContactConsented Boolean   @default(false)
  billingContactConsentAt DateTime?

  students        Student[]
  teacherProfile  TeacherProfile?
  gemWallet       GemWallet?
  consentTokens   ConsentToken[]
  studentBookings Booking[]        @relation("StudentBookings")
  badges          StudentBadge[]
  gemTransactions GemTransaction[]
  rankSnapshots   RankSnapshot[]

  ledgerEntries        StudentLedgerEntry[] @relation("StudentLedgerEntries")
  createdLedgerEntries StudentLedgerEntry[] @relation("StudentLedgerCreatedBy")

  recurringSlots     RecurringSlot[]
  scheduledLessons   ScheduledLesson[]
  assessmentAttempts AssessmentAttempt[] @relation("StudentAssessmentAttempts")
  submissions        Submission[]        @relation("StudentSubmissions")
  testReports        TestReport[]        @relation("StudentTestReports")

  // Classroom badges (see ClassroomBadgeAward) — a student's own collection
  // and, for a teacher's User row, the awards they have handed out.
  classroomBadgesReceived ClassroomBadgeAward[] @relation("ClassroomBadgeRecipient")
  classroomBadgesAwarded  ClassroomBadgeAward[] @relation("ClassroomBadgeAwarder")

  // Batch placements over time (see BatchMember) — at most one is active.
  batchMemberships BatchMember[] @relation("StudentBatchMemberships")

  @@index([assignedTeacherId])
  @@index([assignedCourseId])
}

model Student {
  id         String    @id @default(uuid())
  parentId   String
  name       String
  age        Int
  createdAt  DateTime  @default(now())
  grade      String?
  schoolName String?
  subject    String?
  timezone   String?
  bookings   Booking[]
  parent     User      @relation(fields: [parentId], references: [id])
  avatarUrl  String?

  @@index([parentId])
}

model TeacherProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  bio             String?
  hourlyRate      Int      @default(25)
  createdAt       DateTime @default(now())
  isSuspended     Boolean  @default(false)
  strikes         Int      @default(0)
  stripeAccountId String?
  stripeOnboarded Boolean  @default(false)
  ratingAvg       Float    @default(0)
  reviewCount     Int      @default(0)
  grades          String[] @default([])
  points          Int      @default(0)
  rankTier        Int      @default(0)
  subjects        String[] @default([])
  timezone        String?
  weeklyPoints    Int      @default(0)

  // Manual salary payout (all teachers are BD-based; Lumexa pays out
  // manually each month to bank or bKash, no payment processor involved).
  payoutMethod          String? // "bank" | "bkash"
  bankAccountName       String?
  bankAccountNumber     String?
  bankName              String?
  bankBranch            String?
  bkashNumber           String?
  // Locked by Operations after the first salary payout is sent to the
  // account on file, so a teacher can't silently redirect future payouts —
  // changes after that must go through support.
  payoutLocked          Boolean               @default(false)
  // Locked by Operations once the profile has been verified (100%
  // completeness + manual review), so verification docs can't be swapped
  // out afterwards. Teachers can freely upload/reupload before that.
  docsLocked            Boolean               @default(false)
  reviews               Review[]
  shifts                Shift[]
  cancellations         TeacherCancellation[]
  rescheduleRequests    RescheduleRequest[]
  payoutEntries         PayoutEntry[]
  monthlyPayoutStatuses MonthlyPayoutStatus[]
  user                  User                  @relation(fields: [userId], references: [id])
  verificationDocs      Json?                 @default("[]") // Array of { type, url, name, uploadedAt }
  assignedStudents      User[]                @relation("AssignedTeacher")
  recurringSlots        RecurringSlot[]
  scheduledLessons      ScheduledLesson[]
  batches               Batch[]
  batchSessions         BatchSession[]
  vivaRecords           VivaRecord[]
  submissions           Submission[]
  testReports           TestReport[]
  trialClasses          TrialLead[]           @relation("TrialClassTeacher")

  @@index([ratingAvg(sort: Desc)])
  @@index([isSuspended])
}

model Shift {
  id               String         @id @default(uuid())
  teacherId        String
  start            DateTime
  end              DateTime
  isBooked         Boolean        @default(false)
  createdAt        DateTime       @default(now())
  booking          Booking?
  teacher          TeacherProfile @relation(fields: [teacherId], references: [id])
  recurringGroupId String?

  @@index([teacherId, start])
  @@index([start])
  @@index([isBooked])
}

model Booking {
  id                   String               @id @default(uuid())
  shiftId              String               @unique
  studentId            String? // legacy: references Student sub-entity (nullable for student self-auth bookings)
  studentUserId        String? // new: references User with STUDENT role (self-auth)
  createdAt            DateTime             @default(now())
  amountCents          Int?
  egressId             String?
  paymentIntentId      String?
  paymentStatus        PaymentStatus        @default(PENDING)
  // Recording summary for this class. The recordings themselves are
  // RecordingSegment rows (one per Record → Stop in the teacher's browser, kept
  // in a private Cloudflare R2 bucket); recordingStatus is derived from them by
  // RecordingService. recordingUrl and the merge fields belong to the retired
  // server-side recorder: they are only read, so a recording made then keeps
  // working, and are never written for a new one.
  recordingUrl            String?
  recordingStatus         RecordingStatus @default(NONE)
  recordingStartedAt      DateTime?
  recordingFileSizeBytes  Int?
  recordingMergedAt       DateTime?
  recordingMergeAttempts  Int             @default(0)
  recordingMergeError     String?
  endReason               ClassEndReason?
  endNote                 String?
  shift                Shift                @relation(fields: [shiftId], references: [id])
  student              Student?             @relation(fields: [studentId], references: [id])
  studentUser          User?                @relation("StudentBookings", fields: [studentUserId], references: [id])
  rescheduleRequests   RescheduleRequest[]
  payoutEntries        PayoutEntry[]
  review               Review?
  studentLedgerEntries StudentLedgerEntry[]
  recordingSegments    RecordingSegment[]

  @@index([studentId])
  @@index([studentUserId])
  @@index([paymentStatus])
}

// ─── Reschedule / cancellation audit trail ───────────────────────────────────
//
// One row per reschedule-or-cancel *event* on a booked class (not a mutable
// pending-request row — the action is applied immediately, this is the
// permanent audit record of what happened). Captures who initiated it, why,
// whether proof was supplied, and what policy outcome (penalty review) it
// triggered, so Operations can answer "how many emergency reschedules did
// this teacher make this month, and why" without trusting a bare counter.
model RescheduleRequest {
  id                 String              @id @default(uuid())
  bookingId          String
  teacherId          String
  action             RescheduleAction    @default(RESCHEDULE)
  category           RescheduleCategory
  initiatedByRole    RescheduleInitiator
  oldStart           DateTime
  oldEnd             DateTime
  newStart           DateTime
  newEnd             DateTime
  reason             String?
  proofUrl           String?
  informedStudent    Boolean?
  status             String              @default("CONFIRMED")
  penaltyStatus      PenaltyStatus       @default(NONE)
  penaltyAmountCents Int                 @default(0)
  emergencySeq       Int?
  createdAt          DateTime            @default(now())
  reviewedBy         String?
  reviewedAt         DateTime?

  booking Booking        @relation(fields: [bookingId], references: [id])
  teacher TeacherProfile @relation(fields: [teacherId], references: [id])

  @@index([bookingId])
  @@index([teacherId, category, createdAt])
}

enum RescheduleAction {
  RESCHEDULE
  CANCEL
}

enum RescheduleCategory {
  STUDENT_REQUESTED
  TEACHER_EMERGENCY
  NO_SHOW
  MISUSE
  ADMIN_OVERRIDE
}

enum RescheduleInitiator {
  STUDENT
  PARENT
  TEACHER
  ADMIN
}

enum PenaltyStatus {
  NONE
  PENDING_PENALTY_REVIEW
  PENALTY_APPLIED
  WAIVED
}

// Monthly bucket of teacher-initiated schedule disruptions that count against
// the free-emergency quota (teacher-emergency reschedules; see
// RescheduleCategory.TEACHER_EMERGENCY). Student-requested changes never
// increment this. `@@unique([teacherId, month, year])` makes the increment
// idempotent-by-bucket via upsert.
model TeacherCancellation {
  id        String         @id @default(uuid())
  teacherId String
  month     Int
  year      Int
  count     Int            @default(0)
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, month, year])
}

// ─── Append-only teacher earnings ledger ─────────────────────────────────────
//
// Source of truth for teacher compensation. Never update or delete a row —
// a correction is a new offsetting entry (e.g. +200 original, -50 adjustment).
// amountCents is minor-unit (poisha) and signed: positive for earnings,
// negative for deductions. Idempotency for system-triggered entries is
// enforced by @@unique([referenceType, referenceId, type]) — the same
// underlying event (a booking completing, a specific reschedule penalty)
// can never create a duplicate row.
model PayoutEntry {
  id            String          @id @default(uuid())
  teacherId     String
  type          PayoutEntryType
  amountCents   Int
  bookingId     String?
  description   String
  month         Int
  year          Int
  createdAt     DateTime        @default(now())
  createdBy     String?
  referenceType String?
  referenceId   String?
  metadata      Json?

  teacher TeacherProfile @relation(fields: [teacherId], references: [id])
  booking Booking?       @relation(fields: [bookingId], references: [id])

  @@unique([referenceType, referenceId, type])
  @@index([teacherId, month, year])
  @@index([teacherId, createdAt])
}

enum PayoutEntryType {
  CLASS_COMPLETED
  PTM
  CONVERSION
  PENALTY
  ADJUSTMENT
}

// ─── Monthly payout workflow (Open → Finalized → Paid) ───────────────────────
//
// This never stores or derives the payable amount itself — that always comes
// live from summing PayoutEntry rows for the teacher/month (see
// PayoutsService.getSummary). This row is purely workflow state: has
// Operations locked in the month for payment, and has payment actually gone
// out. finalizedAmountCents/paidAmountCents are a snapshot of the ledger
// total at the moment of that action, kept for audit/reconciliation only —
// never used as the figure Operations pays from once finalized.
model MonthlyPayoutStatus {
  id                   String       @id @default(uuid())
  teacherId            String
  month                Int
  year                 Int
  status               PayoutStatus @default(OPEN)
  finalizedAmountCents Int?
  finalizedBy          String?
  finalizedAt          DateTime?
  paidAmountCents      Int?
  paidBy               String?
  paidAt               DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  teacher TeacherProfile @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, month, year])
  @@index([month, year])
}

enum PayoutStatus {
  OPEN
  FINALIZED
  PAID
}

// ─── Operational/financial audit trail ───────────────────────────────────────
//
// One row per admin action worth remembering: who did what to which entity,
// why, and (optionally) what changed. Never edited or deleted. Surfaced
// inline on the relevant Classes/Teachers/Students/Payouts screens rather
// than a dedicated Audit Log page.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorRole  String?
  action     String
  entityType String
  entityId   String
  reason     String?
  beforeData Json?
  afterData  Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

// ─── In-app dashboard notifications ──────────────────────────────────────────
//
// System-generated alerts surfaced on a user's own dashboard (e.g. a
// teacher's automatic late-join penalty or completed-class earning). Purely
// a read surface over events that already happened elsewhere (PayoutEntry
// is still the financial source of truth) — never itself mutated to create
// or reverse a financial record.
model DashboardAlert {
  id        String   @id @default(uuid())
  userId    String
  role      Role
  type      String
  title     String
  message   String
  metadata  Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
}

model Review {
  id                   String         @id @default(uuid())
  bookingId            String         @unique
  teacherId            String
  rating               Int
  comment              String?
  submittedByParentId  String?
  submittedByStudentId String?
  createdAt            DateTime       @default(now())
  booking              Booking        @relation(fields: [bookingId], references: [id])
  teacher              TeacherProfile @relation(fields: [teacherId], references: [id])

  @@index([teacherId])
}

// ─── Lumexa Platform: Courses, Gems & Trial Leads ────────────────────────────

model Course {
  id               String               @id @default(uuid())
  slug             String               @unique
  title            String
  description      String?
  emoji            String?
  category         String // e.g. "Python", "AI", "Web"
  level            String // "STARTER" | "BEGINNER" | "INTERMEDIATE" | "ADVANCED"
  ageMin           Int                  @default(6)
  ageMax           Int                  @default(18)
  sessions         Int                  @default(12)
  gemCost          Int                  @default(1) // gems per session (student gamification, unrelated to BDT billing)
  // List price for the full course, in poisha (BDT minor unit — see BDT()
  // helper in payout.constants.ts). Nullable: older/custom courses may have
  // no catalog price yet. Used as the default per-lesson rate
  // (priceCents / sessions) when a student's curriculum changes and no
  // actual payment has been recorded against the new curriculum yet — see
  // StudentLedgerService.
  priceCents       Int?
  isActive         Boolean              @default(true)
  // True only for a one-off curriculum an admin builds for a single
  // student/parent via the Custom Curriculum Builder (see CoursesService).
  // Distinct from isActive (which also covers deactivating an ordinary
  // default course) so the default-curriculum .xlsx summary and other
  // "default catalog only" views can filter reliably without guessing from
  // category/isActive.
  isCustom         Boolean              @default(false)
  createdAt        DateTime             @default(now())
  lessons          Lesson[]
  modules          CourseModule[]
  assignedStudents User[]
  ledgerEntries    StudentLedgerEntry[]
  recurringSlots   RecurringSlot[]
  scheduledLessons ScheduledLesson[]
  batches          Batch[]
  batchSessions    BatchSession[]

  @@index([isActive])
  @@index([category])
  @@index([isCustom])
}

// ─── Recurring weekly schedule + generated lesson instances ─────────────────
//
// A student's current assignment (assignedTeacherId + assignedCourseId +
// assignedClassType on User) is scheduled into a weekly recurring pattern by
// Operations: one RecurringSlot row per weekday/time the student meets their
// teacher. ScheduledLesson rows are the individual generated lesson
// instances (see SchedulingService.generateLessons) — one per occurrence,
// up to the course's `sessions` count. All times are computed in Asia/Dhaka
// (fixed UTC+6, no DST) and stored as UTC instants.
//
// Regenerating the schedule (SchedulingService.setSchedule) never touches
// COMPLETED lessons — only UPCOMING ones are replaced — so lesson numbering
// and curriculum progression stay intact across reschedules.

enum ClassType {
  ONE_TO_ONE
  BATCH
}

// Authoritative state of one class occurrence (ScheduledLesson). Every other
// system (student/teacher/admin dashboards, lesson access, the ledger, the
// schedule, notifications) derives from this one column. A row only ever
// leaves UPCOMING once, through ClassFinalizationService.finalize — either by
// the teacher, an admin correction, or the 75-minute platform failsafe — and
// is final after that.
//
//   COMPLETED           lesson finished. Teacher paid, one student lesson
//                       consumed, progression moves to the next lesson.
//   PARTIALLY_COMPLETED lesson not fully covered, one extra class needed.
//                       Same financial effect as COMPLETED (teacher paid, one
//                       lesson consumed, lesson unlocked for the student) and
//                       one extra UPCOMING occurrence is inserted at the same
//                       lessonNumber (see SchedulingService.insertMakeupOccurrence).
//                       Allowed at most once per student+course+lessonNumber.
//   INCOMPLETE          the class could not take place (no-show, technical
//                       problem, ...). No payment, no deduction, no
//                       progression; a make-up occurrence is inserted at the
//                       same lessonNumber so the student still gets the lesson.
//   CANCELLED           admin override from the Classes page — never a class
//                       outcome chosen at end-of-class.
enum LessonStatus {
  UPCOMING
  COMPLETED
  PARTIALLY_COMPLETED
  INCOMPLETE
  CANCELLED
}

// A class's recording as a whole, summarised from its RecordingSegments by
// RecordingService (a student watches the segments themselves, not this):
//   RECORDING  a segment is being recorded right now
//   AVAILABLE  at least one segment is uploaded and can be watched
//   PROCESSING a segment is recorded and waiting to be uploaded by the teacher
//   FAILED     every segment failed — see RecordingSegment.failureReason
//   EXPIRED    every segment was removed by the storage retention policy
// A recording made by the retired server-side recorder keeps the status it had
// (AVAILABLE, with recordingUrl on the class).
enum RecordingStatus {
  NONE
  RECORDING
  PROCESSING
  AVAILABLE
  FAILED
  EXPIRED
}

// One recording segment = one Record → Stop in the teacher's browser. The
// browser records a WebM file, then uploads it straight to a private
// Cloudflare R2 bucket with a short-lived URL this server signed. Recording
// again in the same class makes another segment (a new "part"); segments are
// never merged or overwritten.
enum RecordingSegmentStatus {
  RECORDING // the teacher's browser is recording it
  UPLOADING // recorded and waiting for the teacher to upload it, or being uploaded
  AVAILABLE // the file is in R2 (checked by the server) and can be watched
  FAILED // not uploaded: see failureReason
  EXPIRED // the file was removed from storage by the retention policy
}

model RecordingSegment {
  // Chosen by the teacher's browser (a UUID) when it starts recording, so a
  // retried request can never create a second segment.
  id                String                 @id @default(uuid())
  room              String
  bookingId         String?
  scheduledLessonId String?
  // Retired: the LiveKit Egress job of the old server-side recorder.
  egressId          String?
  status            RecordingSegmentStatus @default(RECORDING)
  // The object key of the file in the R2 bucket (recordings/<room>/<id>.webm).
  storagePath       String?
  fileSizeBytes     Int?
  startedAt         DateTime               @default(now())
  endedAt           DateTime?
  failureReason     String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  // The teacher whose browser made the recording: the only person who may
  // finish, upload or discard it. Null for a segment of the old recorder.
  recordedByUserId  String?
  // What the browser actually recorded, e.g. video/webm;codecs=vp8,opus.
  mimeType          String?
  durationSeconds   Int?
  uploadedAt        DateTime?
  // How many upload URLs were issued for it (retries and resumed uploads).
  uploadAttempts    Int                    @default(0)

  booking         Booking?         @relation(fields: [bookingId], references: [id])
  scheduledLesson ScheduledLesson? @relation(fields: [scheduledLessonId], references: [id])

  @@index([room])
  @@index([bookingId])
  @@index([scheduledLessonId])
  @@index([status])
  @@index([egressId])
  @@index([recordedByUserId])
}

// Why a class was ended INCOMPLETE. STUDENT_LEFT_EARLY and TEACHER_DISCONNECTED
// are legacy values kept only so historical rows stay valid — they are no
// longer offered anywhere (heartbeat-based teacher-disconnect auto-ending was
// removed; the teacher UI offers STUDENT_NO_SHOW / TECHNICAL_ISSUE / OTHER).
enum ClassEndReason {
  STUDENT_NO_SHOW
  STUDENT_LEFT_EARLY
  TECHNICAL_ISSUE
  TEACHER_DISCONNECTED
  OTHER
}

enum ClassroomAdmissionStatus {
  PENDING
  APPROVED
  DENIED
  REMOVED // teacher removed this participant; they must be re-admitted
}

// Google-Meet-style "knock to rejoin" after a teacher removes a participant.
// A plain join always succeeds unless the most recent row for (room, userId)
// is REMOVED — in that case join instead creates/reuses a PENDING row here
// and the student waits for the teacher to Admit/Deny (see
// ClassroomAdmissionService).
model ClassroomAdmission {
  id          String                   @id @default(uuid())
  room        String
  userId      String
  displayName String
  role        String
  status      ClassroomAdmissionStatus @default(PENDING)
  requestedAt DateTime                 @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([room, userId, createdAt])
  @@index([room, status])
}

// The teacher's lock on a classroom. `room` is the classroom's room name (see
// room-ref.util.ts), which is also the name of its Daily room. A room that has
// no row here is unlocked — locking is opt-in and a class starts open. Stored in
// the database (not only in the room's shared state) because that state
// disappears when the meeting ends, and a lock must survive the teacher's
// connection dropping for a moment. While locked, no student can join (see
// RoomAccessService).
model ClassroomRoomState {
  room           String    @id
  locked         Boolean   @default(false)
  lockedAt       DateTime?
  lockedByUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// One badge a teacher awarded to one student during a class (the Lumexa
// Classroom Badge System). The 16 badge definitions live in code
// (server/src/classroom/badges/badge-catalog.ts) — `badgeId` is a key into
// that catalog — so a row here is only "who got what, from whom, where, when".
//
// `requestId` is chosen by the teacher's browser for one award action and is
// what makes a double click or a network retry harmless: the same
// (requestId, student) can only ever be stored once. Awarding the same badge
// to the same student on a later occasion is a different action, so it has a
// different requestId and is stored normally.
//
// Undo does not delete: it sets revokedAt, so there is always a record of
// what happened. Everything that shows a collection ignores revoked rows.
model ClassroomBadgeAward {
  id                String           @id @default(uuid())
  badgeId           String
  requestId         String
  studentUserId     String
  student           User             @relation("ClassroomBadgeRecipient", fields: [studentUserId], references: [id])
  awardedByUserId   String
  awardedBy         User             @relation("ClassroomBadgeAwarder", fields: [awardedByUserId], references: [id])
  // The recipient's own lesson in the class (null for the QA demo room).
  scheduledLessonId String?
  scheduledLesson   ScheduledLesson? @relation(fields: [scheduledLessonId], references: [id], onDelete: SetNull)
  // The classroom (room name) the award was made in.
  room              String
  createdAt         DateTime         @default(now())
  revokedAt         DateTime?
  revokedByUserId   String?

  @@unique([requestId, studentUserId])
  @@index([studentUserId, createdAt])
  @@index([room, createdAt])
  @@index([scheduledLessonId])
}

model RecurringSlot {
  id            String         @id @default(uuid())
  studentUserId String
  student       User           @relation(fields: [studentUserId], references: [id])
  teacherId     String
  teacher       TeacherProfile @relation(fields: [teacherId], references: [id])
  courseId      String
  course        Course         @relation(fields: [courseId], references: [id])
  weekday       Int // 0 = Sunday .. 6 = Saturday, Asia/Dhaka calendar day
  hour          Int // 0-23, Asia/Dhaka local hour
  minute        Int // 0-59, Asia/Dhaka local minute
  classType     ClassType
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([studentUserId])
  @@index([teacherId])
}

model ScheduledLesson {
  id              String         @id @default(uuid())
  studentUserId   String
  student         User           @relation(fields: [studentUserId], references: [id])
  teacherId       String
  teacher         TeacherProfile @relation(fields: [teacherId], references: [id])
  courseId        String
  course          Course         @relation(fields: [courseId], references: [id])
  lessonNumber    Int
  // Direct link to the catalog Lesson this occurrence teaches — resolved at
  // generation/reconciliation time by matching Lesson.order == lessonNumber
  // within the course. Nullable only so older rows created before this field
  // existed remain valid; a backfill sets it for every existing row. Once
  // set, this is what Lesson Details / the assessment interface read from,
  // never the (courseId, lessonNumber) pair directly.
  lessonId        String?
  lesson          Lesson?        @relation(fields: [lessonId], references: [id])
  start           DateTime // UTC instant
  end             DateTime // UTC instant
  classType       ClassType
  status          LessonStatus   @default(UPCOMING)

  // Batch classes: this row is ONE STUDENT'S PARTICIPATION in a shared class
  // (see BatchSession). It keeps everything that is the student's own —
  // attendance, outcome, test attempt, homework, ledger, badges, progress —
  // while the class itself (time, teacher, room, status, earning) belongs to
  // the session. start/end/status/teacherId/lessonNumber are mirrored from the
  // session by the code that writes the session, never edited on their own.
  // A BATCH row always has both set and a 1:1 row never does (CHECK constraint
  // in the batches migration).
  batchId         String?
  batch           Batch?         @relation(fields: [batchId], references: [id], onDelete: Restrict)
  batchSessionId  String?
  batchSession    BatchSession?  @relation(fields: [batchSessionId], references: [id], onDelete: Restrict)

  // Attendance timestamps, set when each side's classroom join token is first
  // issued for this lesson (see ClassroomService.joinScheduledLesson).
  // Teacher lateness is always derived from teacherJoinedAt - start, never
  // a separately-entered value, so it can't drift from the actual schedule.
  teacherJoinedAt DateTime?
  studentJoinedAt DateTime?

  // ─── Recording ──────────────────────────────────────────────────────────
  // recordingStatus summarises this class's RecordingSegment rows (one per
  // Record → Stop in the teacher's browser, kept in a private Cloudflare R2
  // bucket) and is maintained by RecordingService. egressId, recordingUrl and
  // the merge fields belong to the retired server-side recorder (LiveKit
  // Egress): they are only read, so a recording made then keeps working, and
  // are never written for a new one.
  egressId               String?
  recordingStatus        RecordingStatus @default(NONE)
  recordingUrl           String?
  recordingStartedAt     DateTime?
  recordingFileSizeBytes Int?
  recordingMergedAt      DateTime?
  recordingMergeAttempts Int             @default(0)
  recordingMergeError    String?

  // Set exactly once, when the class is finalized (see LessonStatus):
  // endedAt = finalized timestamp, endedByRole = 'TEACHER' | 'ADMIN' |
  // 'SYSTEM' (the 75-minute failsafe). endReason/endNote only apply to
  // INCOMPLETE.
  endedAt      DateTime?
  endedByRole  String?
  endReason    ClassEndReason?
  endNote      String?

  // The teacher closed this student's test (the live "lock" button): the
  // student can no longer start it, and an attempt in progress was submitted
  // with what was saved. See AssessmentsService.lockStudentTest.
  testLockedAt       DateTime?
  testLockedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessmentAttempt AssessmentAttempt?
  submission        Submission?
  ledgerEntries     StudentLedgerEntry[]
  recordingSegments RecordingSegment[]
  badgeAwards       ClassroomBadgeAward[]

  // NOTE: uniqueness of (studentUserId, courseId, lessonNumber) is enforced
  // by a PARTIAL unique index created in migration SQL — scoped to
  // status IN ('UPCOMING', 'COMPLETED') — rather than a plain @@unique here,
  // so a make-up occurrence can legitimately reuse the same lessonNumber as
  // the PARTIALLY_COMPLETED / INCOMPLETE row it follows (see
  // SchedulingService.insertMakeupOccurrence). Prisma can't express a
  // filtered unique index natively, so this stays a plain index for query
  // planning and the real constraint lives only in the migration.
  @@unique([batchSessionId, studentUserId])
  @@index([studentUserId, courseId, lessonNumber])
  @@index([teacherId, start])
  @@index([studentUserId, start])
  @@index([start])
  @@index([lessonId])
  @@index([batchId, studentUserId])
}

// ─── Batches ─────────────────────────────────────────────────────────────────
//
// A Batch is a group of students who learn one curriculum together with one
// teacher on a shared weekly schedule. It is a real record — the membership,
// the schedule and every class it holds live here — not students whose
// individual schedules happen to coincide.
//
//   Batch         the group: teacher, curriculum, capacity, weekly slots.
//   BatchMember   a student's placement in it over time (joinedAt/leftAt). At
//                 most one placement is active per student (partial unique
//                 index in the migration).
//   BatchSession  ONE real live class of the batch: one time, one teacher, one
//                 lesson of the curriculum, one room, one status, one teacher
//                 earning. This is what "the class" is, whatever the number of
//                 students in it.
//   ScheduledLesson (batchSessionId set) a student's own participation in a
//                 session: attendance, outcome, test attempt, homework, ledger
//                 and badges stay per student.
//
// The batch has ONE lesson sequence. A session carries the batch's lesson
// number and every participant row carries the same number, so lesson
// materials, homework and tests move together. A student whose own progress
// does not match the batch's is only ever placed through an explicit admin
// decision (see batches/batch-enrollment.ts) — progress is never rewritten.
//
// Sessions only exist while the batch has a participating student; they are a
// derived projection of (weekly slots, lesson pointer, membership) maintained
// by BatchSessionsService, so an empty batch holds no teacher time.

enum BatchStatus {
  ACTIVE // accepting students and holding classes
  COMPLETED // every lesson of the curriculum has been taught
  ARCHIVED // closed by Operations; no students, no classes
}

model Batch {
  id          String      @id @default(uuid())
  name        String
  notes       String?
  status      BatchStatus @default(ACTIVE)

  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id])
  courseId  String
  course    Course         @relation(fields: [courseId], references: [id])

  // Ideal batch size is 4; Operations may raise it up to the classroom limit
  // of 9 students (MAX_STUDENTS_PER_CLASSROOM).
  maxStudents Int @default(4)

  // Where the batch starts in the curriculum until it has taught a class (a
  // batch built around students who are already on lesson 10 starts at 10).
  startLessonNumber Int @default(1)
  // First class date, 'YYYY-MM-DD' in Asia/Dhaka. Classes are never generated
  // before it.
  startDate         String

  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  slots    BatchSlot[]
  members  BatchMember[]
  sessions BatchSession[]
  lessons  ScheduledLesson[]

  @@index([teacherId])
  @@index([courseId])
  @@index([status])
}

// One weekly meeting time of a batch (Asia/Dhaka local wall-clock time).
model BatchSlot {
  id      String @id @default(uuid())
  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  weekday Int // 0 = Sunday .. 6 = Saturday
  hour    Int // 0-23
  minute  Int // 0-59

  @@unique([batchId, weekday, hour, minute])
  @@index([batchId])
}

model BatchMember {
  id            String    @id @default(uuid())
  batchId       String
  batch         Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  studentUserId String
  student       User      @relation("StudentBatchMemberships", fields: [studentUserId], references: [id])
  joinedAt      DateTime  @default(now())
  // Set when the student leaves or is moved; the row is kept as history.
  leftAt        DateTime?
  // The explicit alignment decision taken when the student joined, so the
  // record shows why a student started at a lesson other than their own next
  // one: ALIGNED | SKIPPED_TO_BATCH | BATCH_REBASED | MIGRATED.
  alignment      String?
  joinedAtLesson Int?
  addedByAdminId String?

  @@index([batchId])
  @@index([studentUserId])
}

model BatchSession {
  id           String         @id @default(uuid())
  batchId      String
  batch        Batch          @relation(fields: [batchId], references: [id])
  // Kept on the session so history stays correct if the batch changes teacher.
  teacherId    String
  teacher      TeacherProfile @relation(fields: [teacherId], references: [id])
  courseId     String
  course       Course         @relation(fields: [courseId], references: [id])
  lessonNumber Int
  lessonId     String?
  lesson       Lesson?        @relation(fields: [lessonId], references: [id])
  start        DateTime // UTC instant
  end          DateTime // UTC instant
  status       LessonStatus   @default(UPCOMING)

  // The teacher's attendance is the class's, not each student's: set when
  // their classroom join token is first issued for this session. Late-join penalty
  // and the 75-minute failsafe key off this one value.
  teacherJoinedAt DateTime?

  // Set once, when the class is finalized (see ClassFinalizationService.
  // finalizeBatchSession). Each participant row also records its own outcome.
  endedAt     DateTime?
  endedByRole String?
  endReason   ClassEndReason?
  endNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ScheduledLesson[]

  @@index([batchId, start])
  @@index([teacherId, start])
  @@index([start])
  @@index([lessonId])
}

// ─── Curriculum content: modules, lesson materials, projects, assessments ───
//
// A Course row (above) is a whole *pathway* (e.g. "AI Builder Path", 24
// sessions; "Lumexa Odyssey", 85 sessions) — that naming predates this
// feature and pricing/enrollment logic depends on it, so it is kept as-is.
// CourseModule is the layer this feature adds: one row per real 8-lesson
// sub-course (e.g. "Python and AI Foundations"), matching the source
// curriculum's own structure and the lumexa-all-lessons/lumexa-all-projects
// repo layout 1:1 (CourseModule.slug == that repo's course folder name).
//
// Lesson (pre-existing) is extended in place to become the canonical
// session row — both plain teaching sessions and test/assessment sessions
// (see SessionType) — rather than introducing a parallel "Session" model,
// so the existing admin drag/reorder editor and ScheduledLesson numbering
// keep working unchanged. `type` distinguishes a learning session from a
// COURSE_TEST/STAGE_TEST/FINAL_TEST session, which carries an Assessment.

enum SessionType {
  LEARNING
  COURSE_TEST
  STAGE_TEST
  FINAL_TEST
}

model CourseModule {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slug        String // matches the source repo's course folder, e.g. "python-ai-foundations"
  title       String
  description String?
  order       Int // position among this course/pathway's modules
  stageNumber Int? // Odyssey only: which of the 3 stages (1/2/3) this module belongs to
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons  Lesson[]
  projects Project[]

  @@unique([courseId, slug])
  @@index([courseId])
}

// One project can span several lessons (Part 1 / Part 2 / Finish) — each
// Lesson.projectId points here, and Lesson.checkpoint carries what's due by
// that specific session. sourceRepoPath is kept purely for traceability
// back to lumexa-all-projects, never read at runtime.
model Project {
  id             String       @id @default(uuid())
  moduleId       String
  module         CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug           String
  title          String
  description    String?
  sourceRepoPath String?
  order          Int // 1, 2, 3 within the module
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lessons Lesson[]

  @@unique([moduleId, slug])
  @@index([moduleId])
}

model Lesson {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  order     Int
  duration  Int      @default(60) // minutes
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id])

  moduleId String?
  module   CourseModule? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  type     SessionType   @default(LEARNING)

  // ─── Lesson Details content (student-visible only once the matching
  // ScheduledLesson is COMPLETED; always visible to the assigned teacher) ──
  objectives      String[] @default([]) // learning objectives for this session
  contentMarkdown String? // the "Learn" material — concept explanation, screenshare-able
  reviewNotes     String? // 5-minute review/recap bullets (previous class + homework check)
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  checkpoint      String? // exact project checkpoint due THIS session, e.g. "Finish sections 1-2"
  codeSnippets    Json? // [{ label, language, code, part }] — cumulative code for this checkpoint
  // [{ title, url }] — external project links (e.g. a Colab notebook) shown
  // as "Open Project" / "Copy Link" buttons in a dedicated section that
  // REPLACES the codeSnippets-driven "Code" section on the lesson page when
  // set (see LessonDetailsView). Null/empty leaves the old Code section as
  // the fallback, so this is opt-in per lesson.
  projectLinks    Json?
  homework        String?
  sourceRefs      Json? // traceability: source repo file paths this content was imported from

  scheduledLessons ScheduledLesson[]
  batchSessions    BatchSession[]
  assessment       Assessment?
  submissions      Submission[]

  @@index([courseId])
  @@index([moduleId])
  @@index([projectId])
}

// ─── Student homework submissions ────────────────────────────────────────────
//
// One row per ScheduledLesson occurrence that a student has submitted
// homework for (@unique scheduledLessonId — resubmitting the same occurrence
// overwrites fileUrl/note/submittedAt in place rather than creating a second
// row, so "already submitted" is always a single unambiguous lookup). Only
// created once the student actually submits — a lesson with homework but no
// Submission row yet is exactly the "needs attention" case surfaced on
// Student Home. lessonId/teacherId are denormalized from the ScheduledLesson
// at submission time so teacher review queries (by teacher, by catalog
// lesson) never need to join through it.
model Submission {
  id                String           @id @default(uuid())
  scheduledLessonId String           @unique
  scheduledLesson   ScheduledLesson  @relation(fields: [scheduledLessonId], references: [id])
  lessonId          String
  lesson            Lesson           @relation(fields: [lessonId], references: [id])
  studentUserId     String
  student           User             @relation("StudentSubmissions", fields: [studentUserId], references: [id])
  teacherId         String
  teacher           TeacherProfile   @relation(fields: [teacherId], references: [id])
  // Array of { url: string; name: string | null } — a submission can attach
  // multiple files (e.g. several source files or a project + a screenshot).
  files             Json             @default("[]")
  // External links the student wants to share instead of/alongside files
  // (e.g. a Scratch project page, a GitHub repo, a Replit).
  links             String[]         @default([])
  note              String? // optional message the student attaches
  status            SubmissionStatus @default(PENDING)
  // Teacher's 1–5 star rating for this submission, set when reviewed.
  rating            Int?
  // Selected predefined feedback phrases (see SUBMISSION_FEEDBACK_TAGS) —
  // shown to the student alongside any free-text `feedback`.
  feedbackTags      String[]         @default([])
  // How many times the student has resubmitted after a NEEDS_CHANGES
  // review — 0 for a first-time submission.
  resubmissionCount Int              @default(0)
  submittedAt       DateTime         @default(now())
  reviewedAt        DateTime?
  feedback          String? // optional free-text teacher note left when reviewing
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Files handed in since homework moved to Cloudflare R2 (see HomeworkFile).
  // `files` above only holds what was uploaded to Cloudinary before that.
  homeworkFiles     HomeworkFile[]

  @@index([studentUserId])
  @@index([teacherId, status])
  @@index([lessonId])
}

// One homework file kept in the PRIVATE homework R2 bucket (HOMEWORK_R2_BUCKET —
// never the class-recordings bucket). The row is the only record of the object:
// who it belongs to, where it is, and whether it is still needed. The file lives
// exactly as long as its submission waits for a review; once the teacher has
// saved the review it is removed from R2 (status DELETE_PENDING until R2
// confirms it, then DELETED) while the row — and the submission, grade and
// feedback — stay as history. See HomeworkFilesService.
model HomeworkFile {
  id                  String                    @id @default(uuid())
  // Set when the file becomes part of a submission; null while it is only
  // uploaded. If the submission is ever deleted the file is orphaned and swept.
  submissionId        String?
  submission          Submission?               @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  // Whose work it is, for which assignment (the ScheduledLesson that owns the
  // lesson's homework slot) and which course. Plain ids, not foreign keys: the
  // file's lifecycle must never block deleting those records.
  studentUserId       String
  scheduledLessonId   String
  courseId            String
  // The object's key in the homework bucket (unique: one row per object).
  objectKey           String                    @unique
  originalName        String
  contentType         String
  sizeBytes           Int
  status              HomeworkFileStatus        @default(UPLOADED)
  deleteReason        HomeworkFileDeleteReason?
  // Removal attempts that failed, the last error and when — the retry backoff.
  deleteAttempts      Int                       @default(0)
  lastDeleteError     String?
  lastDeleteAttemptAt DateTime?
  // Set when a newer submission replaced this one's files: it is no longer the
  // file anyone is shown, whatever state its removal is in.
  supersededAt        DateTime?
  createdAt           DateTime                  @default(now())
  attachedAt          DateTime?
  deleteRequestedAt   DateTime?
  deletedAt           DateTime?

  @@index([submissionId])
  @@index([studentUserId, scheduledLessonId])
  @@index([status, createdAt])
  @@index([status, lastDeleteAttemptAt])
}

enum HomeworkFileStatus {
  UPLOADED // stored in R2, not (yet) part of a submission
  ATTACHED // part of a submission — kept until it has been reviewed
  DELETE_PENDING // no longer needed; removal from R2 not confirmed yet (retried)
  DELETED // removed from R2 (the row is kept as history)
}

enum HomeworkFileDeleteReason {
  REVIEWED // the teacher saved the review
  REPLACED // the student handed in different work
  ABANDONED // uploaded but never submitted
  ORPHANED // its submission no longer exists
}

enum SubmissionStatus {
  PENDING // Submitted — awaiting teacher review (covers first submits and resubmits)
  APPROVED
  NEEDS_CHANGES
}

model GemWallet {
  id        String        @id @default(uuid())
  userId    String        @unique
  balance   Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id])
  purchases GemPurchase[]
}

model GemPurchase {
  id            String         @id @default(uuid())
  walletId      String
  gems          Int
  amountCents   Int
  currency      String         @default("USD") // "USD" | "BDT"
  paymentMethod String // "STRIPE" | "BKASH" | "BANK_TRANSFER"
  status        PurchaseStatus @default(PENDING)
  externalRef   String? // Stripe PI id, bKash trxID, or bank ref
  proofUrl      String? // bank transfer proof image URL
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  wallet        GemWallet      @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([status])
}

// ─── Student BDT credit ledger ───────────────────────────────────────────────
//
// Append-only source of truth for a student's tuition credit balance. Never
// update a row — a correction is a new offsetting entry (see
// ADMIN_ADJUSTMENT / REFUND). The only deletion is an explicit admin delete of a
// non-lesson row (StudentLedgerService.deleteEntry), which rebuilds the running
// balanceAfterCents of the rows after it in the same transaction. amountCents is BDT minor-unit (poisha, see
// BDT() helper in payout.constants.ts) and signed: positive credits the
// balance (PAYMENT_RECEIVED), negative debits it (LESSON_COMPLETED, REFUND).
// balanceAfterCents and rateCents are snapshots of the running balance and
// the effective per-lesson rate immediately after this entry — because
// entries are immutable and always appended in order, the latest row's
// balanceAfterCents IS the student's current balance (no separate stored
// counter to drift out of sync). rateCents carries forward unchanged on
// entries that don't change pricing (LESSON_COMPLETED, REFUND,
// ADMIN_ADJUSTMENT) and is recomputed on PAYMENT_RECEIVED (amountCents /
// lessonsPurchased) and on CURRICULUM_CHANGE (new course's list rate, when
// known). Idempotency for the automatic per-booking consumption trigger is
// enforced by @@unique([bookingId, type]) — Postgres treats NULL bookingId
// values as distinct, so this only constrains LESSON_COMPLETED rows. The
// curriculum (ScheduledLesson) flow's consumption trigger mirrors this with
// its own scheduledLessonId + @@unique([scheduledLessonId, type]) — the two
// columns never collide since a row is only ever written by one flow.
model StudentLedgerEntry {
  id                String                 @id @default(uuid())
  studentUserId     String
  student           User                   @relation("StudentLedgerEntries", fields: [studentUserId], references: [id])
  type              StudentLedgerEntryType
  amountCents       Int
  balanceAfterCents Int
  rateCents         Int // effective per-lesson rate (poisha) in effect after this entry; 0 if unknown
  lessonsPurchased  Float? // set on PAYMENT_RECEIVED only, for display/audit
  // How the student actually paid — set on PAYMENT_RECEIVED/REFUND only.
  // paymentDetail carries the specific bKash number / bank name+account the
  // payment came in on, for Operations to reconcile against.
  paymentMethod     String? // "BKASH" | "BANK" | "CASH" | "OTHER"
  paymentDetail     String?
  courseId          String?
  course            Course?                @relation(fields: [courseId], references: [id])
  courseName        String // denormalized curriculum name snapshot at event time
  description       String?
  createdByAdminId  String?
  createdByAdmin    User?                  @relation("StudentLedgerCreatedBy", fields: [createdByAdminId], references: [id])
  bookingId         String?
  booking           Booking?               @relation(fields: [bookingId], references: [id])
  scheduledLessonId String?
  scheduledLesson   ScheduledLesson?       @relation(fields: [scheduledLessonId], references: [id])
  createdAt         DateTime               @default(now())

  @@unique([bookingId, type])
  @@unique([scheduledLessonId, type])
  @@index([studentUserId, createdAt])
}

enum StudentLedgerEntryType {
  PAYMENT_RECEIVED
  LESSON_COMPLETED
  CURRICULUM_CHANGE
  CREDIT_CARRIED_FORWARD
  REFUND
  ADMIN_ADJUSTMENT
}

model ConsentToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique @default(uuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([token])
}

// ─── Trial classes ────────────────────────────────────────────────────────────
//
// A TrialLead is a parent's free-trial request. Rows created before the
// booking calendar existed have no appointment (appointmentStatus = null).
// Every row created through the booking flow carries a confirmed 30-minute
// appointment: `startAt`/`endAt` are UTC instants, and recurring availability
// is configured in `Asia/Dhaka` (see TrialAvailabilityRule).
//
// Two CONFIRMED appointments can never start less than 60 minutes apart
// (30-minute session + mandatory 30-minute gap). The service enforces this
// inside a transaction guarded by an advisory lock, and the migration adds an
// exclusion constraint ("TrialLead_no_overlapping_slots") as a database-level
// backstop that no code path can bypass.
model TrialLead {
  id          String   @id @default(uuid())
  parentName  String
  parentEmail String
  // E.164 (e.g. +8801712345678). Null only for legacy leads created before
  // the booking form collected it. Never exposed on public endpoints.
  parentPhone String?
  childName   String
  childAge    Int
  subject     String
  timezone    String? // the parent's browser timezone — informational only
  message     String?
  status      String   @default("NEW") // "NEW" | "CONTACTED" | "BOOKED" | "CONVERTED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  whatsappConsent   Boolean   @default(false)
  whatsappConsentAt DateTime?

  startAt           DateTime?
  endAt             DateTime?
  appointmentStatus TrialAppointmentStatus?
  bookedBy          String                  @default("PARENT") // "PARENT" | "ADMIN"
  // Bumped on every reschedule; part of the WhatsApp reminder dedupe key so a
  // moved appointment gets exactly one reminder for its new time.
  revision          Int                     @default(0)
  cancelledAt       DateTime?
  cancelReason      String?
  adminNotes        String?                 @db.Text

  // ─── Teacher assignment + guest classroom access ──────────────────────────
  // A trial has no student account and no ScheduledLesson: it is a standalone
  // 30-minute session between this lead's child and the assigned teacher, held
  // in the Daily room "trial-<id>" (see classroom/room-ref.util.ts). Nothing
  // here touches lesson balance, curriculum progress, payouts or enrolment.
  //
  // `guestToken` is the secret in the parent's join link (/trial/join/<token>).
  // It is generated when the booking is created, only sent once a teacher is
  // assigned, never returned by any admin/teacher/public API, and only ever
  // grants entry to THIS trial's room, inside the joining window, while the
  // appointment is CONFIRMED (see trial-access.util.ts).
  guestToken        String?   @unique
  teacherId         String?
  teacher           TeacherProfile? @relation("TrialClassTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  teacherAssignedAt DateTime?
  teacherJoinedAt   DateTime?
  guestJoinedAt     DateTime?
  // When the 1-hour reminder (email) becomes due, and when it was sent. Null
  // due-date = no reminder (no teacher yet, or the link went out less than an
  // hour before the start). Reset on every reschedule; the WhatsApp reminder
  // has its own durable row in TrialWhatsAppMessage.
  reminderDueAt       DateTime?
  reminderEmailSentAt DateTime?

  whatsappMessages TrialWhatsAppMessage[]

  @@index([status])
  @@index([teacherId, startAt])
  @@index([reminderDueAt])
  @@index([appointmentStatus, startAt])
  @@index([startAt])
  @@index([parentEmail])
}

// CONFIRMED = the slot is held (and, with a teacher, the class is on their
// calendar). COMPLETED / MISSED are set after the start time (by the admin, or
// by the teacher ending the class) and release nothing: only CONFIRMED rows
// hold a slot (see the TrialLead_no_overlapping_slots constraint).
enum TrialAppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  MISSED
}

// Weekly recurring availability, evaluated in `timezone` (Asia/Dhaka). Several
// rows may share a weekday (e.g. Wed 15:00–19:00 and Wed 21:00–23:00).
// weekday: 0=Sunday..6=Saturday. startMinute/endMinute: minutes after local
// midnight, multiples of 30, 0 ≤ start < end ≤ 1440. effectiveFrom/Until are
// inclusive 'YYYY-MM-DD' local dates (null = open-ended).
model TrialAvailabilityRule {
  id             String   @id @default(uuid())
  weekday        Int
  startMinute    Int
  endMinute      Int
  timezone       String   @default("Asia/Dhaka")
  effectiveFrom  String?
  effectiveUntil String?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([weekday])
}

// One-off availability on a single local calendar date ('YYYY-MM-DD').
model TrialAvailabilityWindow {
  id          String   @id @default(uuid())
  date        String
  startMinute Int
  endMinute   Int
  timezone    String   @default("Asia/Dhaka")
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

// Holiday / unavailable period. Covers startDate..endDate inclusive; when
// startMinute/endMinute are set only that part of each day is blocked.
// Blocks always win over rules and one-off windows.
model TrialBlockedPeriod {
  id          String   @id @default(uuid())
  startDate   String
  endDate     String
  startMinute Int?
  endMinute   Int?
  reason      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startDate, endDate])
}

// Durable outbox for the three trial WhatsApp messages. A row is written in
// the same transaction as the booking, then delivered by TrialWhatsAppService
// (immediately after commit, and by a once-a-minute sweep for retries and the
// scheduled reminder) so nothing depends on in-memory timers. `dedupeKey` is
// unique, so a retried job can never create — or send — a second copy.
// Trial *emails* are not stored here: they go through EmailService/EmailLog.
enum TrialWhatsAppKind {
  PARENT_CONFIRMATION
  PARENT_CLASS_DETAILS
  PARENT_REMINDER
  ADMIN_ALERT
}

enum TrialWhatsAppStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

model TrialWhatsAppMessage {
  id                String              @id @default(uuid())
  trialLeadId       String
  trialLead         TrialLead           @relation(fields: [trialLeadId], references: [id], onDelete: Cascade)
  kind              TrialWhatsAppKind
  revision          Int                 @default(0)
  dedupeKey         String              @unique
  status            TrialWhatsAppStatus @default(PENDING)
  scheduledFor      DateTime
  // Next time the sweep may try this row. Null on a FAILED row = out of
  // retries (or a permanent error) — only a manual admin retry revives it.
  nextAttemptAt     DateTime?
  attempts          Int                 @default(0)
  lockedAt          DateTime?
  lastError         String?
  errorCode         String?
  providerMessageId String?
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status, nextAttemptAt])
  @@index([trialLeadId])
}

model TeacherStudentNote {
  id        String   @id @default(uuid())
  teacherId String
  studentId String
  isUserRef Boolean  @default(false)
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId, studentId])
}

model StudentBadge {
  id       String   @id @default(uuid())
  userId   String
  type     String
  earnedAt DateTime @default(now())
  metadata Json?
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, type])
  @@index([userId])
}

model GemTransaction {
  id          String   @id @default(uuid())
  userId      String
  amount      Int
  type        String
  description String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model RankSnapshot {
  id         String   @id @default(uuid())
  userId     String
  globalRank Int
  cohortRank Int
  month      Int
  year       Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, month, year])
  @@index([userId])
}

enum Role {
  PARENT
  STUDENT
  TEACHER
  ADMIN
}

enum AccountStatus {
  PENDING_CONSENT
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PAUSED
}

enum SpaceRank {
  STARCHILD // 0–4 sessions
  EXPLORER // 5–14 sessions
  COSMONAUT // 15–29 sessions
  NAVIGATOR // 30–59 sessions
  CAPTAIN // 60–99 sessions
  GALAXY_COMMANDER // 100+ sessions
}

enum PaymentStatus {
  PENDING
  CAPTURED
  REFUNDED
  FAILED
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ─── Native assessment system (MCQ + practical coding + AI-assisted grading) ─
//
// One Assessment per test-type Lesson (COURSE_TEST / STAGE_TEST /
// FINAL_TEST — see SessionType), 1:1 via Lesson.assessment. Its
// MCQQuestion/PracticalQuestion rows ARE its question bank: admin manages
// them scoped to that one assessment, which is itself already organized by
// curriculum → module → course/test via the Lesson it belongs to.
//
// The one exception is a CUSTOM curriculum that imports a default
// curriculum's test session: that lesson gets its own Assessment row (own
// attempts, own publish/pass settings) whose questions are NOT copied —
// `sourceAssessmentId` points at the original bank, and every read/write of
// questions resolves through it (see AssessmentsService.resolveBank). So a
// question fixed once in the original course is fixed everywhere it is used.
//
// Standardized banks (see server/src/assessments/bank):
//   COURSE_TEST / STAGE_TEST — 30 four-option MCQs + 10 True/False
//   FINAL_TEST               — 25 four-option MCQs + 5 True/False + one
//                              15-minute coding project (manually marked)
// Every attempt presents the whole published bank, one mark per question.
// Submitting generates a TestReport (below) for the teacher to evaluate.

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED // answers locked, objective part auto-graded, report awaiting the teacher
  GRADED // teacher approved the report — results released
}

enum QuestionKind {
  MCQ // four options, exactly one correct
  TRUE_FALSE // options are always ["True", "False"]
}

model Assessment {
  id                 String      @id @default(uuid())
  lessonId           String      @unique
  lesson             Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type               SessionType // COURSE_TEST | STAGE_TEST | FINAL_TEST
  title              String
  instructions       String?
  // Legacy: used to cap how many MCQs were drawn per attempt. Standardized
  // tests always present the whole bank, so this is no longer read.
  mcqCount           Int          @default(0)
  randomizeQuestions Boolean     @default(true)
  randomizeOptions   Boolean     @default(true)
  passScorePct       Int         @default(60)
  // Legacy Part C (live viva) — superseded by the coding project on Final
  // Tests. Kept so historical VivaRecord/attempt data stays readable.
  vivaMaxScore       Float        @default(20)
  isPublished        Boolean     @default(false)
  // See the block comment above: when set, this assessment's questions are
  // read from (and edited on) that assessment instead of its own rows.
  sourceAssessmentId String?
  sourceAssessment   Assessment?  @relation("AssessmentQuestionBank", fields: [sourceAssessmentId], references: [id], onDelete: SetNull)
  linkedAssessments  Assessment[] @relation("AssessmentQuestionBank")
  // Version of the maintained bank content (server/src/assessments/bank)
  // last applied to this assessment; 0 = never synced (legacy generated bank).
  bankVersion        Int          @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  mcqQuestions       MCQQuestion[]
  practicalQuestions PracticalQuestion[]
  attempts           AssessmentAttempt[]

  @@index([type])
  @@index([sourceAssessmentId])
}

model MCQQuestion {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionType  QuestionKind @default(MCQ)
  questionText String
  options       Json // string[] — four for MCQ, ["True", "False"] for TRUE_FALSE
  correctIndex Int
  explanation  String?
  difficulty   String? // "EASY" | "MEDIUM" | "HARD"
  tags         String[]   @default([])
  order        Int        @default(0)
  isPublished  Boolean    @default(true)
  // Stable identity of a question that comes from the maintained bank
  // content, so the idempotent bank sync updates it in place instead of
  // inserting a duplicate on every boot. Null for admin-authored questions.
  bankKey       String?
  // Set when an admin edits the question on the Question Bank page — a later
  // bank-content release never overwrites an admin's edit.
  editedByAdmin Boolean      @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  answers MCQAnswer[]

  @@unique([assessmentId, bankKey])
  @@index([assessmentId])
}

model PracticalQuestion {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  title        String
  instructions String
  language     String     @default("javascript")
  starterCode  String?
  testCases    Json? // [{ name, input, expectedOutput, description }]
  rubric       Json? // [{ criterion, maxPoints }]
  maxScore     Int        @default(100)
  order        Int        @default(0)
  isPublished  Boolean    @default(true)
  bankKey      String? // see MCQQuestion.bankKey
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  submissions PracticalSubmission[]

  @@unique([assessmentId, bankKey])
  @@index([assessmentId])
}

// One per (assessment, student) — created lazily the first time a student
// opens the assessment interface for their test-type ScheduledLesson.
model AssessmentAttempt {
  id                String           @id @default(uuid())
  assessmentId      String
  assessment        Assessment       @relation(fields: [assessmentId], references: [id])
  studentUserId     String
  student           User             @relation("StudentAssessmentAttempts", fields: [studentUserId], references: [id])
  scheduledLessonId String?          @unique
  scheduledLesson   ScheduledLesson? @relation(fields: [scheduledLessonId], references: [id])
  status            AttemptStatus    @default(NOT_STARTED)
  // The randomized subset/order of MCQQuestion ids actually presented to
  // this student, frozen at attempt start so re-loading the page (or a
  // teacher/admin reviewing later) sees exactly what the student saw.
  mcqQuestionIds    String[]         @default([])
  mcqScore          Float?
  mcqMaxScore       Float?
  practicalScore    Float?
  practicalMaxScore Float?
  vivaScore         Float?
  vivaMaxScore      Float?
  totalScore        Float?
  totalMaxScore     Float?
  passed            Boolean?
  startedAt         DateTime?
  submittedAt       DateTime?
  gradedAt          DateTime?
  // Set when a teacher locked the test and the attempt was auto-submitted with
  // whatever had been saved (instead of the student pressing Submit).
  lockedAt          DateTime?
  lockedByUserId    String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  mcqAnswers           MCQAnswer[]
  practicalSubmissions PracticalSubmission[]
  vivaRecord           VivaRecord?
  report               TestReport?

  @@index([studentUserId])
  @@index([assessmentId])
}

model MCQAnswer {
  id            String            @id @default(uuid())
  attemptId     String
  attempt       AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String
  question      MCQQuestion       @relation(fields: [questionId], references: [id])
  selectedIndex Int?
  isCorrect     Boolean           @default(false)
  // The randomized display order of that question's options for this
  // student (indices into MCQQuestion.options), so selectedIndex can be
  // mapped back correctly on review even though display order was shuffled.
  optionOrder   Int[]             @default([])
  answeredAt    DateTime          @default(now())

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// The student's coding-project code. Autosaved as a draft while the attempt is
// IN_PROGRESS, frozen on submit. `score` is only ever written by the teacher's
// manual evaluation (TestReport.codingScore mirrors it) — automated test-case
// results (deterministicResult) and AI notes (aiEvaluation) are advisory
// context for the teacher, never the mark.
model PracticalSubmission {
  id                  String            @id @default(uuid())
  attemptId           String
  attempt             AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId          String
  question            PracticalQuestion @relation(fields: [questionId], references: [id])
  code                String
  deterministicResult Json? // { passed, total, cases: [{ name, passed, message }] }
  aiEvaluation        Json? // { score, strengths: [], issues: [], feedback, provider, model } | { error }
  aiEvaluatedAt       DateTime?
  score               Float?
  submittedAt         DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// ─── Test Evaluation Report Cards ────────────────────────────────────────────
//
// One per submitted AssessmentAttempt, created in the SAME transaction that
// submits it (AssessmentsService.submitAttempt) so a submission can never
// exist without its report. The objective section (MCQ + True/False) is graded
// automatically at that moment; the teacher then reviews, may override
// individual questions, marks the coding project (Final Tests), approves the
// report, and finally shares it with the parent.
//
//   Course/Stage test:  PENDING_REVIEW ──approve──▶ READY_TO_SHARE ──share──▶ SHARED_WITH_PARENTS
//   Final test:         PENDING_CODE_EVALUATION ──approve (all rubric criteria scored)──▶ READY_TO_SHARE ──share──▶ SHARED_WITH_PARENTS
//
// Automatic results are never rewritten: `autoObjectiveScore` and each
// question's `autoCorrect` stay as graded, and a teacher's change is stored
// next to it (`questionResults[].override`, `objectiveScore`, `teacherEdited`)
// so a report always shows what the system graded vs. what the teacher
// changed. Course/lesson/test titles are snapshotted (plain ids, no FKs —
// same approach as Certificate) so the report stays a faithful record even if
// the curriculum or a question is edited later. SHARED_WITH_PARENTS is only
// ever set after EmailService confirmed the message was accepted for delivery
// — never optimistically (see TestReportsService.share).
enum TestReportStatus {
  PENDING_REVIEW
  PENDING_CODE_EVALUATION
  READY_TO_SHARE
  SHARED_WITH_PARENTS
}

model TestReport {
  id            String            @id @default(uuid())
  attemptId     String            @unique
  attempt       AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  assessmentId  String
  studentUserId String
  student       User              @relation("StudentTestReports", fields: [studentUserId], references: [id])
  // The teacher who evaluates it — the class's teacher at submission time.
  teacherId     String
  teacher       TeacherProfile    @relation(fields: [teacherId], references: [id])

  courseId          String
  courseTitle       String
  lessonId          String?
  scheduledLessonId String?
  assessmentType    SessionType
  testTitle         String
  status            TestReportStatus
  passScorePct      Int

  // Objective section. `autoObjectiveScore` is the automatic grade and never
  // changes; `objectiveScore` = auto grade adjusted by teacher overrides.
  mcqTotal           Int
  trueFalseTotal     Int
  autoObjectiveScore Float
  objectiveScore     Float
  objectiveMaxScore  Float
  // [{ questionId, order, kind, text, options, selectedIndex, correctIndex,
  //    autoCorrect, explanation, override: { correct, note, at } | null }]
  // options/selectedIndex/correctIndex are in the order the student saw.
  questionResults    Json

  // Coding project — Final Tests only, marked manually by the teacher.
  hasCodingProject   Boolean   @default(false)
  // { questionId, title, instructions, language, code, submittedAt }
  codingProject      Json?
  codingMaxScore     Float?
  // [{ criterion, maxPoints, score: number | null }] — score null = not marked yet
  codingRubricScores Json?
  codingScore        Float? // null until every rubric criterion has a mark
  codingFeedback     String?
  codingEvaluatedAt  DateTime?

  // Recomputed on every edit. total/percentage/passed stay null while the
  // coding project is still unmarked, so a half-finished report never shows
  // a misleading total.
  totalMaxScore Float
  totalScore    Float?
  percentage    Float?
  passed        Boolean?

  feedback      String?
  strengths     String?
  improvements  String?
  // True once a teacher changed anything (a question override, marks or text).
  teacherEdited Boolean @default(false)

  submittedAt        DateTime
  lastEditedAt       DateTime?
  lastEditedByUserId String?
  approvedAt         DateTime?
  approvedByUserId   String?

  // Parent sharing (the only parent-facing channel in the app is email to the
  // student's billing contact, falling back to the account email — the same
  // recipient rule certificates and package alerts use).
  sharedAt           DateTime?
  sharedByUserId     String?
  sharedToEmail      String?
  shareRecipientKind String? // 'BILLING_CONTACT' | 'STUDENT_ACCOUNT'
  shareEmailLogId    String? // EmailLog row, for the real delivery status
  shareAttempts      Int       @default(0)
  // Set while an email send is in flight (cleared when it finishes), so a second
  // click can never start another send while the first is still going out.
  shareStartedAt     DateTime?
  lastShareError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId, status])
  @@index([studentUserId])
  @@index([status, createdAt])
}

// ─── Centralized email notification system ───────────────────────────────────
//
// EmailService (server/src/email/email.service.ts) is the ONLY place that
// sends outbound mail (Gmail SMTP via Nodemailer). Every send is first
// journaled here as PENDING, then attempted immediately (fire-and-forget —
// callers never block on delivery) and updated to SENT/FAILED. A cron sweep
// retries FAILED rows below the attempt cap, giving the "lightweight
// queue" behavior without a separate broker. `dedupeKey` is how one-shot
// notifications (a specific booking confirmed, a specific certificate
// issued) stay idempotent: callers pass a deterministic key and rely on the
// unique constraint (P2002) to no-op a duplicate attempt — the same pattern
// StudentLedgerEntry uses for LESSON_COMPLETED rows.
enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model EmailLog {
  id            String      @id @default(uuid())
  toEmail       String
  subject       String
  html          String      @db.Text // full rendered body, kept so the retry sweep can resend without the original caller re-running
  category      String // e.g. "STUDENT_WELCOME", "CLASS_REMINDER" — informational, not FK'd to an enum so new categories never need a migration
  dedupeKey     String?     @unique
  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  lastError     String?
  relatedUserId String? // best-effort reference for admin/debug lookup — not a Prisma relation, deliberately decoupled so this model never blocks on user deletion
  // { attachments?: { filename: string; path: string }[] } — `path` is a
  // local file path or remote URL Nodemailer can fetch, never inline binary,
  // so a retry never needs to regenerate a certificate/curriculum PDF.
  metadata      Json?
  createdAt     DateTime    @default(now())
  sentAt        DateTime?
  updatedAt     DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([relatedUserId])
  @@index([category, createdAt])
}

// ─── Forgot Password ──────────────────────────────────────────────────────────
//
// Only the SHA-256 hash of the reset token is ever stored — the raw token
// (crypto.randomBytes(32)) exists only in the emailed link and briefly in
// memory server-side. Single-use: usedAt is set the moment the password is
// actually changed, and AuthService.resetPassword refuses any token that is
// expired, already used, or not found — the same generic error either way.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─── Package/subscription balance alerts ──────────────────────────────────────
//
// Tracks the last alert level actually emailed to a student's billing
// contact so the daily threshold check (PackageAlertsService) only emails
// on a state TRANSITION (NONE→EXPIRING_SOON, →EXPIRED) — never repeatedly
// while the balance sits in the same bracket, and resets silently (no email)
// the moment a new payment lifts the student back out of it.
enum PackageAlertLevel {
  NONE
  EXPIRING_SOON
  EXPIRED
}

model PackageAlertState {
  id            String             @id @default(uuid())
  studentUserId String             @unique
  lastState     PackageAlertLevel  @default(NONE)
  lastSentAt    DateTime?
  updatedAt     DateTime           @updatedAt
}

// ─── Curriculum-completion certificates ───────────────────────────────────────
//
// One row per (student, completed course) — @@unique enforces that a
// certificate is issued at most once per curriculum per student, which is
// also how CertificateService.checkAndIssueCertificate stays idempotent
// (relies on the P2002 from a duplicate create, same pattern as
// StudentLedgerEntry). Deliberately holds no Prisma relation to User/Course
// (plain ids only) so this model never gains a migration dependency on
// those — see CertificateService for the lookups.
model Certificate {
  id                     String   @id @default(uuid())
  studentUserId          String
  courseId               String
  courseName             String // denormalized snapshot at issue time
  certificateNumber      String   @unique
  pdfUrl                 String
  issuedAt               DateTime @default(now())
  recommendedCourseId    String?
  recommendedCourseName  String?
  metadata               Json? // progress report snapshot (lessons completed, hours, final score, etc.)

  @@unique([studentUserId, courseId])
  @@index([studentUserId])
}

// ─── Disputes / complaints ─────────────────────────────────────────────────────
//
// Minimal filing record for "a class dispute or complaint filed by a
// student/teacher" (no existing model covered this — Review is a rating,
// not a complaint). Filing sends an admin alert email; resolution is a
// simple status flip from the admin dashboard. Plain scalar references
// only, by design — see the Certificate comment above for why.
enum DisputeStatus {
  OPEN
  RESOLVED
}

model Dispute {
  id                 String        @id @default(uuid())
  filedByUserId      String
  filedByRole        Role
  againstUserId      String?
  scheduledLessonId  String?
  bookingId          String?
  category           String
  description        String
  status             DisputeStatus @default(OPEN)
  createdAt          DateTime      @default(now())
  resolvedAt         DateTime?
  resolvedByAdminId  String?
  resolutionNotes    String?

  @@index([status, createdAt])
  @@index([filedByUserId])
}

// Final Test Part C — teacher-recorded viva/demo.
model VivaRecord {
  id                  String            @id @default(uuid())
  attemptId           String            @unique
  attempt             AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  recordedByTeacherId String
  recordedByTeacher   TeacherProfile    @relation(fields: [recordedByTeacherId], references: [id])
  questions           Json // [{ question, response, notes }]
  score               Float?
  maxScore            Float             @default(20)
  remarks             String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}
